    {
      "parameters": {
        "jsCode": "const f = $input.first().json;\nconst arten = { \"Wartung einschalten\": \"maintenance\", \"Störung einschalten\": \"incident\", \"Hinweis einschalten\": \"info\" };\nconst dauern = { \"1 Stunde\": 1, \"4 Stunden\": 4, \"1 Tag\": 24, \"3 Tage\": 72 };\nconst aktiv = f[\"Aktion\"] in arten;\nconst roh = f[\"Bereiche\"];\nconst bereiche = Array.isArray(roh) ? roh.join(\", \") : (roh || \"\");\nconst stunden = dauern[f[\"Dauer\"]];\nconst bis = aktiv && stunden ? new Date(Date.now() + stunden * 3600000).toISOString() : \"\";\nconst text = (f[\"Text\"] || \"\").trim() || \"Ich arbeite gerade am Server und an der Website, es kann zu Ausfällen kommen.\";\nreturn [{ json: { ref: \"main\", inputs: { aktiv: String(aktiv), art: arten[f[\"Aktion\"]] || \"maintenance\", titel: \"\", text, bis, bereiche } } }];"
      },
      "type": "n8n-nodes-base.code",
